{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigbio/sdrf-autoannotation/schemas/reviewer.schema.json",
  "title": "SDRF reviewer agent output contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "accession",
    "artifacts",
    "verdict",
    "deterministic",
    "findings"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "role": {"const": "reviewer"},
    "accession": {"$ref": "#/$defs/accession"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "verdict": {"enum": ["pass", "fail", "blocked"]},
    "blocked_reason": {"type": ["string", "null"], "minLength": 1},
    "deterministic": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check"],
        "properties": {
          "check": {"type": "string", "minLength": 1},
          "templates": {"type": "array", "items": {"type": "string"}},
          "passed": {"type": "boolean"},
          "score": {"type": "number"},
          "detail": {"type": "string"}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "literature_agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed", "contradictions"],
      "properties": {
        "reviewed": {"type": "array", "items": {"type": "string"}},
        "contradictions": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "comment": "A fail with no finding gives the creator nothing to repair, so the repair loop would spin without a target.",
      "if": {"properties": {"verdict": {"const": "fail"}}, "required": ["verdict"]},
      "then": {"properties": {"findings": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "blocked"}}, "required": ["verdict"]},
      "then": {
        "required": ["blocked_reason"],
        "properties": {"blocked_reason": {"type": "string", "minLength": 1}}
      }
    }
  ],
  "$defs": {
    "accession": {"type": "string", "pattern": "^[A-Z]{3}[A-Z0-9]*[0-9]+$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^sdrf/[^/]+\\.sdrf\\.tsv$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "file", "claim", "evidence", "recommendation"],
      "properties": {
        "severity": {"enum": ["error", "warning", "info"]},
        "file": {"type": "string"},
        "row": {"type": ["integer", "null"]},
        "column": {"type": ["string", "null"]},
        "claim": {"type": "string"},
        "evidence": {"type": "string"},
        "recommendation": {"type": "string"}
      }
    }
  }
}
