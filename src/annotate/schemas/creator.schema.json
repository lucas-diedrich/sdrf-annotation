{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigbio/sdrf-autoannotation/schemas/creator.schema.json",
  "title": "SDRF creator agent output contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "accession",
    "outcome",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "role": {
      "const": "creator"
    },
    "accession": {
      "$ref": "#/$defs/accession"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "failed"
      ]
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sdrf/[^/]+\\.sdrf\\.tsv$"
      },
      "description": "Workspace-relative paths only. The host hashes them itself; an agent-computed hash of its own output proves nothing."
    },
    "raw_files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "completed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "blocked"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "blocked_reason"
        ],
        "properties": {
          "blocked_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "accession": {
      "type": "string",
      "pattern": "^[A-Z]{3}[A-Z0-9]*[0-9]+$"
    }
  }
}