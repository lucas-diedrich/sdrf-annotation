{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigbio/sdrf-autoannotation/schemas/creator.schema.json",
  "title": "SDRF creator agent output contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "accession", "outcome", "sdrf_files"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "role": {
      "const": "creator"
    },
    "accession": {
      "$ref": "#/$defs/accession"
    },
    "outcome": {
      "enum": ["completed", "blocked", "failed"]
    },
    "blocked_reason": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Inferences the evidence supports but does not state. Prose, deliberately: these are read when auditing one dataset, not counted across many."
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      },
      "description": "Values the sources never stated. Nothing upstream can fix these."
    },
    "spec_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      },
      "description": "Values the specification cannot express. Kept apart from unresolved because these are actionable by the SDRF maintainers."
    },
    "sdrf_files": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sdrf/[^/]+\\.sdrf\\.tsv$"
      },
      "description": "The SDRF files written, and nothing else. Evidence under files/ is not listed here. The host hashes the disk itself, so this is a cross-check, not the source of truth."
    },
    "raw_files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "completed"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "sdrf_files": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "blocked"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "required": ["blocked_reason"],
        "properties": {
          "blocked_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "accession": {
      "type": "string",
      "pattern": "^[A-Z]{3}[A-Z0-9]*[0-9]+$"
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "detail"],
      "properties": {
        "column": {
          "type": ["string", "null"],
          "description": "The SDRF column the trouble is in. This is the only field that gets counted across datasets, so it must be a real column name. Null only where a run predating this contract was migrated."
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "description": "One sentence, read after a count points at the column. Never parsed."
        }
      }
    }
  }
}
